# JATA Qi v1.0.0 — Production environment (EXAMPLE ONLY — no real credentials).
# Copy to /opt/jataqi/production.env and fill with REAL secrets. Never commit
# this file. Rotate everything before first use.

# --- runtime ------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
JATAQI_GATEWAY_HOST=0.0.0.0
JATAQI_GATEWAY_PORT=7400

# --- bootstrap admin (create a STRONG password, rotate after first login) ----
JATAQI_ADMIN_USERNAME=CHANGE_ME
JATAQI_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM

# --- storage ------------------------------------------------------------------
# postgres for production (filesystem/sqlite only for single-node labs)
STORAGE_DRIVER=postgres
POSTGRES_URL=postgres://jataqi:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/jataqi
# Postgres driver connection pool
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=20

# --- redis (optional; used when configured) -----------------------------------
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379

# --- TLS (native gateway termination; edge nginx may terminate instead) -------
# TLS_CERT_PATH=/etc/letsencrypt/live/api.example.com/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/api.example.com/privkey.pem

# --- backups (disaster recovery) ----------------------------------------------
BACKUP_NAMESPACES=security.audit,commerce.plans,commerce.subscriptions,commerce.invoices,privacy.classifications
BACKUP_INTERVAL_MS=3600000
BACKUP_RETENTION=48
BACKUP_NOTIFY_RECIPIENT=ops@example.com

# --- payments (PRODUCTION keys — strictly separate from sandbox/test keys) ----
# Never reuse sandbox keys in production. Webhook signature verification is
# enforced when STRIPE_WEBHOOK_SECRET is set.
# STRIPE_SECRET_KEY=<production live key>
# STRIPE_WEBHOOK_SECRET=<production webhook secret>
# M-Pesa / Flutterwave / Pesapal / Airtel production credentials:
# MPESA_CONSUMER_KEY=...  MPESA_CONSUMER_SECRET=...  MPESA_PASSKEY=...
# FLUTTERWAVE_SECRET_KEY=...  FLUTTERWAVE_WEBHOOK_SECRET=...

# --- providers / integrations ---------------------------------------------------
# OPENAI_API_KEY=sk-...            # agent LLM provider (production)
# SENDGRID_API_KEY=SG.xxx          # email channel
# TWILIO_ACCOUNT_SID=... TWILIO_AUTH_TOKEN=... FROM_NUMBER=+1...
# AFRICAS_TALKING_API_KEY=... AFRICAS_TALKING_USERNAME=... AFRICAS_TALKING_SENDER_ID=...

# --- observability --------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=...   # tracing
# PROMETHEUS_SCRAPE=1               # /metrics is always enabled
