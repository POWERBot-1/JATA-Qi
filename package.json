{
  "name": "jataqi",
  "version": "0.1.0",
  "private": true,
  "description": "JATA Qi — Modular AI Operating System",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check:workspaces": "node scripts/check-workspace-lockfile.mjs",
    "prebuild": "npm run check:workspaces",
    "build": "node scripts/run-workspaces.mjs build",
    "pretest": "npm run check:workspaces",
    "test": "node scripts/run-workspaces.mjs test",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
