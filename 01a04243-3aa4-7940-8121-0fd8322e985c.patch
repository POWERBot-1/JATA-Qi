@@ -0,0 +1,32 @@
+{
+  "name": "@jataqi/autonomous-test-repair",
+  "version": "0.1.0",
+  "description": "JATA Qi autonomous test/repair loop — governed test execution, diagnosis, proposal, and verification lifecycle",
+  "type": "module",
+  "main": "dist/src/index.js",
+  "types": "dist/src/index.d.ts",
+  "exports": {
+    ".": {
+      "types": "./dist/src/index.d.ts",
+      "import": "./dist/src/index.js"
+    }
+  },
+  "scripts": {
