@@ -0,0 +1,31 @@
+{
+  "name": "@jataqi/commercial-observability",
+  "version": "0.1.0",
+  "description": "JATA Qi Commercial Observability — privacy-minimized CCP event projections, traces, evidence-classified metrics, local alerts, incident records, and no automatic remediation",
+  "type": "module",
+  "main": "dist/src/index.js",
+  "types": "dist/src/index.d.ts",
+  "exports": {
+    ".": {
+      "types": "./dist/src/index.d.ts",
+      "import": "./dist/src/index.js"
+    }
+  },
+  "scripts": {
+    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
