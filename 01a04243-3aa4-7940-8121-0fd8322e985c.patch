+++ b/packages/cli/src/bootstrap.ts
@@ -5,6 +5,44 @@ import { StorageModule, type StorageModuleConfig } from '@jataqi/storage';
 import { VectorSearchModule, type VectorModuleConfig } from '@jataqi/vector-search';
