{
  "name": "@jataqi/loop-host",
  "version": "0.1.0",
  "description": "JATA Qi O-01 durable continuous-operation host — scheduler, wake-sleep, leased queue, and checkpoint-resume driver over the existing governed unified loop (not a second orchestrator)",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && node -e \"require('fs').copyFileSync('test/two-process-worker.mjs','dist/test/two-process-worker.mjs')\"",
    "clean": "rm -rf dist",
    "test": "node --test dist/test/*.test.js",
    "pretest": "npm run build"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@jataqi/authentication": "0.1.0",
    "@jataqi/commercial-control-plane": "0.1.0",
    "@jataqi/core-kernel": "0.1.0",
    "@jataqi/storage": "0.1.0",
    "@jataqi/unified-loop": "0.1.0"
  },
  "devDependencies": {
    "@jataqi/storage-postgres": "0.1.0",
    "@types/node": "^20.11.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "typescript": "^5.4.0"
  }
}
