{
  "name": "@jataqi/automation",
  "version": "0.1.0",
  "description": "JATA Qi SOMA AI Intelligent Automation Engine (Phase 6) — scheduled, event-driven, and manual automations with chained actions across memory, notifications, knowledge, agents, and tools",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "test": "node --test dist/test/*.test.js",
    "pretest": "npm run build"
  },
  "files": ["dist", "src"],
  "license": "MIT",
  "dependencies": {
    "@jataqi/core-kernel": "0.1.0",
    "@jataqi/memory": "0.1.0",
    "@jataqi/notifications": "0.1.0",
    "@jataqi/knowledge-service": "0.1.0",
    "@jataqi/agent-runtime": "0.1.0",
    "@jataqi/tool-intelligence": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0"
  }
}
