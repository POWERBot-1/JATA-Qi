{
  "name": "@jataqi/commercial-event-stream",
  "version": "0.1.0",
  "description": "JATA Qi Commercial Event Stream — durable contract validation, idempotent delivery, bounded retry, replay, and dead-letter records",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && node -e \"require('fs').copyFileSync('test/t05-delivery-worker.mjs','dist/test/t05-delivery-worker.mjs')\"",
    "clean": "rm -rf dist",
    "test": "node --test dist/test/*.test.js",
    "pretest": "npm run build"
  },
  "files": ["dist", "src"],
  "license": "MIT",
  "dependencies": {
    "@jataqi/commercial-control-plane": "0.1.0",
    "@jataqi/core-kernel": "0.1.0",
    "@jataqi/storage": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0",
    "@jataqi/storage-postgres": "0.1.0",
    "embedded-postgres": "^18.4.0-beta.17"
  }
}
