{
  "name": "@jataqi/tanya",
  "version": "0.1.0",
  "description": "TANYA AI \u2014 JATA Qi conversational product layer: personas over the agent runtime, persistent conversations, PKI IdP identity bridge, and tool-call-aware chat history",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "test": "node --test dist/test/*.test.js",
    "pretest": "npm run build"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@jataqi/agent-runtime": "0.1.0",
    "@jataqi/conversations": "0.1.0",
    "@jataqi/core-kernel": "0.1.0",
    "@jataqi/knowledge-graph": "0.1.0",
    "@jataqi/knowledge-service": "0.1.0",
    "@jataqi/pki": "0.1.0",
    "@jataqi/vector-search": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0"
  }
}
