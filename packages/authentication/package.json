{
  "name": "@jataqi/authentication",
  "version": "0.1.0",
  "description": "JATA Qi T-01 authenticated server-side principal boundary. Server-side principal/tenant/roles derivation from an authenticator abstraction. No live identity provider required; deterministic test authenticator for tests; real provider activation is explicitly gated.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && node -e \"require('fs').copyFileSync('test/p2-s2-fanout-worker.mjs','dist/test/p2-s2-fanout-worker.mjs')\"",
    "clean": "rm -rf dist",
    "test": "node --test dist/test/*.test.js",
    "pretest": "npm run build"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@jataqi/commercial-control-plane": "0.1.0",
    "@jataqi/core-kernel": "0.1.0",
    "@jataqi/storage": "0.1.0"
  },
  "devDependencies": {
    "@jataqi/storage-postgres": "0.1.0",
    "@types/node": "^20.11.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "typescript": "^5.4.0"
  }
}
