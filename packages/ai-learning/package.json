{
  "name": "@jataqi/ai-learning",
  "version": "0.1.0",
  "description": "JATA Qi AI Learning — prompt registry (versioning + approval), response quality tracking, drift detection, model benchmarking. Composes @jataqi/memory. Zero external deps.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "node --test dist/test/*.test.js",
    "pretest": "npm run build"
  },
  "files": ["dist", "src"],
  "license": "MIT",
  "dependencies": {
    "@jataqi/core-kernel": "0.1.0",
    "@jataqi/memory": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0"
  }
}
