{
  "name": "@jataqi/storage-postgres",
  "version": "0.1.0",
  "description": "JATA Qi P-01 authoritative, transactional PostgreSQL storage driver implementing @jataqi/storage's IStorageDriver, ICollection compare-and-swap, and multi-operation transactions. Persistence only — no cognition, policy, or authorization.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "test": "node --test dist/test/*.test.js",
    "pretest": "npm run build"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@jataqi/storage": "0.1.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@jataqi/core-kernel": "0.1.0",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "typescript": "^5.4.0"
  }
}
