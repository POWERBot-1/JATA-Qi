{
  "name": "@jataqi/api-gateway",
  "version": "0.1.0",
  "description": "JATA Qi API Gateway — HTTP entrypoint exposing auth, QiL, orchestration and audit",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "test": "node --test dist/test/*.test.js",
    "pretest": "npm run build"
  },
  "files": ["dist", "src"],
  "license": "MIT",
  "dependencies": {
    "@jataqi/core-kernel": "0.1.0",
    "@jataqi/security": "0.1.0",
    "@jataqi/orchestrator": "0.1.0",
    "@jataqi/agent-runtime": "0.1.0",
    "@jataqi/knowledge-service": "0.1.0",
    "@jataqi/metrics": "0.1.0",
    "@jataqi/simulation": "0.1.0",
    "@jataqi/teams": "0.1.0",
    "@jataqi/plugins": "0.1.0",
    "@jataqi/model-registry": "0.1.0",
    "@jataqi/scheduler": "0.1.0",
    "@jataqi/compute": "0.1.0",
    "@jataqi/robotics": "0.1.0",
    "@jataqi/digital-twin": "0.1.0",
    "@jataqi/tool-intelligence": "0.1.0",
    "@jataqi/readiness": "0.1.0",
    "@jataqi/provenance": "0.1.0",
    "@jataqi/commerce": "0.1.0",
    "@jataqi/organizations": "0.1.0",
    "@jataqi/notifications": "0.1.0",
    "@jataqi/policies": "0.1.0",
    "@jataqi/feature-flags": "0.1.0",
    "@jataqi/privacy": "0.1.0",
    "@jataqi/policy-governance": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0"
  }
}
