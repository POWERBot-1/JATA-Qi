{
  "name": "@jataqi/fx",
  "version": "0.1.0",
  "description": "JATA Qi KARIS FX — Foreign Exchange Intelligence (Phase 6): rate engine with cross rates, bid/ask spreads, conversion, history, trend and volatility analytics",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
