{
  "name": "@jataqi/search",
  "version": "0.1.0",
  "description": "JATA Qi Universal Search & Discovery (Phase 6) — federated search across knowledge, memory, graph, conversations, and tools with personalized ranking",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "test": "node --test dist/test/*.test.js",
    "pretest": "npm run build"
  },
  "files": ["dist", "src"],
  "license": "MIT",
  "dependencies": {
    "@jataqi/core-kernel": "0.1.0",
    "@jataqi/memory": "0.1.0",
    "@jataqi/learning": "0.1.0",
    "@jataqi/knowledge-service": "0.1.0",
    "@jataqi/knowledge-graph": "0.1.0",
    "@jataqi/conversations": "0.1.0",
    "@jataqi/tool-intelligence": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0"
  }
}
