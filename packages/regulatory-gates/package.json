{
  "name": "@jataqi/regulatory-gates",
  "version": "0.1.0",
  "description": "JATA Qi local regulatory-gate foundation — tenant-configured evidence/human-review requirement evaluation, immutable audit records, explicit external-verification pending state, and no physical authorization",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "test": "node --test dist/test/*.test.js",
    "pretest": "npm run build"
  },
  "files": ["dist", "src"],
  "license": "MIT",
  "dependencies": {
    "@jataqi/commercial-control-plane": "0.1.0",
    "@jataqi/core-kernel": "0.1.0",
    "@jataqi/human-approval": "0.1.0",
    "@jataqi/research-evidence": "0.1.0",
    "@jataqi/storage": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0"
  }
}
