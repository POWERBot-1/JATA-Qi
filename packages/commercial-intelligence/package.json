{
  "name": "@jataqi/commercial-intelligence",
  "version": "0.1.0",
  "description": "JATA Qi Commercial Intelligence — evidence-bound opportunity scoring, readiness gates, and recommendation-only commercial analysis",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "test": "node --test dist/test/*.test.js",
    "pretest": "npm run build"
  },
  "files": ["dist", "src"],
  "license": "MIT",
  "dependencies": {
    "@jataqi/commercial-analytics": "0.1.0",
    "@jataqi/commercial-control-plane": "0.1.0",
    "@jataqi/core-kernel": "0.1.0",
    "@jataqi/storage": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0",
    "@jataqi/commercial-event-stream": "0.1.0"
  }
}
