# JATA Qi environment configuration
# Copy to .env for local development.

# Logging: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Storage driver: memory | filesystem | postgres
# IMPORTANT: memory and filesystem are development-only. filesystem is
# single-process local storage: not transactional, multi-process, multi-host, or
# authoritative production storage.
# 'postgres' (R-01) selects the P-01 durable substrate and is the only driver the
# supervised `jataqi host` process will run on without an explicit opt-out.
STORAGE_DRIVER=memory
# Directory for development-only filesystem storage (ignored by Git by default).
STORAGE_FS_ROOT=./.jataqi/storage

# --- R-01 durable persistence (required when STORAGE_DRIVER=postgres) --------
# Supply a PostgreSQL connection string. NEVER commit a real credential: this
# file is an example only and .env is git-ignored. Missing configuration fails
# closed (PostgresConfigError) rather than silently defaulting to localhost.
# JATAQI_PG_CONNECTION_STRING=postgres://user:password@host:5432/jataqi
JATAQI_PG_CONNECTION_STRING=
# Optional label shown in pg_stat_activity.
JATAQI_PG_APPLICATION_NAME=jataqi-host

# --- Operator tenant (REQUIRED for every tenant-facing CLI command) ----------
# S-1/B-4 + B-5: this single variable is the tenant the CLI process operates as.
# It is REQUIRED by:
#   * the knowledge-facing commands (ask, ingest, search, stats, entities, repl);
#   * the R-01 read-only inspection commands (host:work / host:dlq / host:health
#     / host:outbox / host:inbox), which resolve it BEFORE the kernel boots.
#
# There is NO default tenant. A missing, blank, or reserved `default` value is
# REFUSED with exit code 1 and nothing is booted, read, written, or searched —
# the shared default bucket may never be operated through the CLI. `--tenant` on
# the command line is a consistency check only: it must equal this value and can
# never establish, override, or widen it.
#
# Set a real tenant id for your deployment (the sample below is a placeholder —
# copying it verbatim gives you a tenant named "tenant-acme", not a working one).
JATAQI_OPERATOR_TENANT=tenant-acme
JATAQI_OPERATOR_ID=cli-operator
# Set to 'true' ONLY for a genuinely cross-tenant operator. Default is
# single-tenant read access.
JATAQI_OPERATOR_GLOBAL_ADMIN=false

# NOTE: durable persistence is NOT production-grade durability. R-01 provides no
# backup, restore, PITR, replication, or failover; RPO and RTO are UNDEFINED.

# --- T-03 authenticated work ingress ----------------------------------------
# JATA Qi ships NO identity provider. The authentication posture below decides
# who `jataqi host:enqueue` will accept, and the DEFAULT accepts nobody.
#
#   none          (default) No authenticator is registered. Every authenticated
#                 ingress request fails closed. This is deliberate: an
#                 unconfigured process must not silently trust anything.
#   static-token  @jataqi/authentication's StaticTokenAuthenticator, built only
#                 from an explicit principal file. Its contract scopes it to
#                 development/staging — NOT production traffic.
#   test-only     DeterministicTestAuthenticator. Requires this mode AND
#                 JATAQI_ALLOW_TEST_AUTH=true. Two deliberate acts, so test
#                 authority can never be enabled by accident.
JATAQI_AUTH_MODE=none
# Path to a JSON array of principal records. Required for static-token and
# test-only; there is NO default principal table.
#   static-token: [{"token":"...","principalId":"...","tenantId":"...","roles":["agent"]}]
#   test-only:    [{"id":"...","tenantId":"...","roles":["agent"]}]
# The "system" role is refused: it denotes a kernel-internal actor and may never
# be granted to an externally-presented credential.
JATAQI_AUTH_PRINCIPALS=
# Second, redundant opt-in for test authority. Must be exactly "true".
JATAQI_ALLOW_TEST_AUTH=false
# Credential material presented by `jataqi host:enqueue`. Read from the
# environment — never argv — so it never appears in process listings or shell
# history. The authentication METHOD comes from JATAQI_AUTH_MODE, not from the
# caller.
JATAQI_AUTH_TOKEN=
# T-02 principal-snapshot freshness horizon (ms) enforced by the host.
# Defaults to 24h; capped at 30 days.
# JATAQI_MAX_PRINCIPAL_AGE_MS=86400000

# --- P1 production security posture ------------------------------------------
# 'development' (DEFAULT) keeps today's behavior exactly. 'production' enforces
# the P1 production security composition: the configuration is validated before
# boot and kernel security invariants abort boot unless ALL of these hold:
#   * durable security enabled (the R2 S-1..S-10 substrate is mandatory);
#   * STORAGE_DRIVER=postgres with an explicit connection (memory/filesystem
#     are refused — they are development-only);
#   * durable sessions enabled (revocation visible across processes);
#   * an external (KMS/HSM-class) credential material provider is injected —
#     the in-memory provider is refused;
#   * the PostgreSQL RLS posture is verified at boot (non-superuser,
#     non-BYPASSRLS runtime role; RLS + FORCE on every security table);
#   * security-state health is established (boot canary renders a DENY).
# Unknown values fail closed. There is no runtime path that relaxes the
# posture after boot.
JATAQI_SECURITY_POSTURE=development
# Optional JSON file of seed capability manifests for the durable authority
# (production posture). Boot aborts on divergence from durable ACTIVE policy
# without an approved rotation record.
# JATAQI_SEED_MANIFESTS=./manifests.json
# Static bearer tokens are the weakest admitted authentication method. Under
# the production posture they require this SECOND explicit opt-in and verify
# ONLY through the durable S-9 fingerprint registry (never a plaintext
# constructor table). Production identity (OIDC/mTLS) is P2 scope.
JATAQI_ALLOW_STATIC_TOKEN_PRODUCTION=false

# Embedding model: hash | openai
VECTOR_MODEL=hash
VECTOR_HASH_DIM=128
VECTOR_METRIC=cosine

# OpenAI embedding configuration (used when VECTOR_MODEL=openai)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Agent LLM: echo | openai. Echo is a deterministic test double. Configuring
# OpenAI is optional local/provider testing and does not make this repository production-ready.
AGENT_LLM=echo
OPENAI_CHAT_MODEL=gpt-4o-mini
