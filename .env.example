# JATA Qi environment configuration
# Copy to .env for local development.

# Logging: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Storage driver: memory | filesystem | sqlite | postgres
STORAGE_DRIVER=memory
# Directory for filesystem driver / path for sqlite (only used when STORAGE_DRIVER=filesystem|sqlite)
STORAGE_FS_ROOT=./.jataqi/storage

# PostgreSQL (set STORAGE_DRIVER=postgres for multi-writer horizontal scaling, PR8).
# The driver implements the PostgreSQL v3 wire protocol in pure Node (zero deps);
# supports trust / cleartext / md5 / SCRAM-SHA-256 auth and optional TLS.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=jataqi
# TLS: disable | prefer | require
PGSSLMODE=disable
# Encryption at rest (AES-256-GCM). Set to enable transparent encryption of all
# stored values/docs/blobs. Accepts a 44-char base64 string, 64-char hex string,
# or a passphrase. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STORAGE_ENCRYPTION_KEY=
# Default per-namespace/collection byte quota (0/unset = unlimited). Protects
# against unbounded growth / noisy-tenant DoS.
STORAGE_DEFAULT_QUOTA_BYTES=
# JSON map of per-name byte quotas, e.g. {"security.audit":10485760,"security.sessions":1048576}
STORAGE_QUOTAS=

# Embedding model: hash | openai
VECTOR_MODEL=hash
VECTOR_HASH_DIM=128
VECTOR_METRIC=cosine

# OpenAI embedding configuration (used when VECTOR_MODEL=openai)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Agent LLM: echo | openai  (echo is deterministic test double; set to openai for production)
AGENT_LLM=echo
OPENAI_CHAT_MODEL=gpt-4o-mini

# Security / identity — a bootstrap admin is created on first boot when both are set.
JATAQI_ADMIN_USERNAME=
JATAQI_ADMIN_PASSWORD=
# Persist authentication sessions to durable storage so they survive restarts (default true).
SECURITY_PERSIST_SESSIONS=true

# HTTP API gateway (used by `jataqi serve`)
JATAQI_GATEWAY_PORT=7400
JATAQI_GATEWAY_HOST=0.0.0.0

# --- Security hardening (PR4) ---
# API versioning segment. Set to 'false' to disable versioned routing. Default 'v1'.
API_VERSION=v1
# CORS: comma-separated allow-list of origins, or '*'. Leave unset to disable CORS.
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=
# Allow cookies/credentials in CORS (requires an explicit origin allow-list, not '*').
CORS_CREDENTIALS=false
# TLS/HTTPS: provide BOTH a cert and key path to enable HTTPS (HSTS auto-enabled).
# Generate a cert with, e.g.: openssl req -x509 -newkey rsa:2048 -keyout key.pem -out cert.pem -days 365 -nodes -subj "/CN=your.host"
TLS_CERT_PATH=
TLS_KEY_PATH=
# Optional CA bundle for mutual TLS (client certificate verification).
TLS_CA_PATH=
# Minimum TLS protocol version (default TLSv1.2).
TLS_MIN_VERSION=TLSv1.2

# --- Scheduled backups (PR4 — automated disaster recovery) ---
# Comma-separated storage namespaces to snapshot on a schedule (e.g. security.audit,dr.snapshots).
BACKUP_NAMESPACES=
# Backup interval in ms (default 6h = 21600000).
BACKUP_INTERVAL_MS=21600000
# Snapshots to retain per namespace (default 10).
BACKUP_RETENTION=10


# --- OpenTelemetry distributed tracing (PR9) ---
# Service name reported on spans (e.g. jataqi-api, jataqi-worker).
OTEL_SERVICE_NAME=jataqi
# Exporter: none | console | otlp
OTEL_TRACES_EXPORTER=none
# OTLP/HTTP collector endpoint when exporter=otlp (e.g. http://otel-collector:4318/v1/traces)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Sampler: always_on | always_off | traceidratio | parentbased_always_on
OTEL_TRACES_SAMPLER=parentbased_always_on
# Sampling ratio for traceidratio (0..1)
OTEL_TRACES_SAMPLER_ARG=

# --- Payment provider (PR11) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email/SMS providers (PR12) ---
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_SENDER_ID=

# --- PRX Part L: Legal Operation Mode + accreditation ---
# Operation mode: DEVELOPMENT (default) | PRIVATE_INFRASTRUCTURE | ACCREDITED_PRODUCTION
JATAQI_OPERATION_MODE=DEVELOPMENT
# Governance Ed25519 private key (PKCS#8 DER, base64) that signs accreditation
# grants. Omit to use an ephemeral per-boot key (dev only). In production supply
# a key held in a KMS/HSM — never commit it.
JATAQI_GOVERNANCE_KEY=

# --- PRX Part D: Global DNS platform ---
# Set to 1 to start the authoritative UDP/TCP DNS server on boot.
JATAQI_DNS_SERVE=0
JATAQI_DNS_PORT=8053
JATAQI_DNS_HOST=127.0.0.1
# Set to 1 to enable the recursive resolver API (sends real DNS over UDP).
JATAQI_DNS_RECURSIVE=0

# --- PRX Part A/B: Registry (EPP) + Registrar ---
# Set to 1 to start the EPP server (RFC 5734) on boot.
JATAQI_EPP_SERVE=0
JATAQI_EPP_PORT=17000
JATAQI_EPP_SVID=registry.jataqi.local
