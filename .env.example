# JATA Qi environment configuration
# Copy to .env for local development.

# Logging: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Storage driver: memory | filesystem
STORAGE_DRIVER=memory
# Directory for filesystem driver (only used when STORAGE_DRIVER=filesystem)
STORAGE_FS_ROOT=./.jataqi/storage

# Embedding model: hash | openai
VECTOR_MODEL=hash
VECTOR_HASH_DIM=128
VECTOR_METRIC=cosine

# OpenAI embedding configuration (used when VECTOR_MODEL=openai)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Agent LLM: echo | openai  (echo is deterministic test double; set to openai for production)
AGENT_LLM=echo
OPENAI_CHAT_MODEL=gpt-4o-mini
